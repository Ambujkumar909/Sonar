# Sonar configuration — copy to .env and edit. (.env is gitignored.)
# docker-compose.yml reads ALL of these from .env.

# ---- ports & database ----
PORT=4545
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar
POSTGRES_DB=sonar
# App → DB. In Docker the host is the compose service name 'db'.
# For a LOCAL (non-docker) run, change 'db' to 'localhost'.
DATABASE_URL=postgres://sonar:sonar@db:5432/sonar

# ---- first-run super admin (seeded once) ----
SONAR_SUPERADMIN_USER=admin@sonar
SONAR_SUPERADMIN_PASS=Admin@123$

# ---- retention / limits ----
RETAIN_DAYS=30
MAX_SESSIONS=50
LOCALE=en-IN

# ---- licensing (offline, key-based — no server) ----
# Leave EMPTY to run unrestricted (disabled).
# To enforce, paste ONE key from license-keys.txt below; it validates on boot.
# When it expires, replace it with the next key and restart.
LICENSE_KEY=
