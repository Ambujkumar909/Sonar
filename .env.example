# Sonar configuration — copy to .env and edit. (.env is gitignored.)
# docker-compose.yml reads ALL of these from .env.

# ---- ports & database ----
PORT=4545
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar
POSTGRES_DB=sonar
# App → DB. In Docker the host is the compose service name 'db'.
# For a LOCAL (non-docker) run, change 'db' to 'localhost'.
DATABASE_URL=postgres://sonar:sonar@db:5432/sonar

# ---- first-run super admin (seeded once) ----
SONAR_SUPERADMIN_USER=admin@sonar
SONAR_SUPERADMIN_PASS=Admin@123$

# ---- retention / limits ----
RETAIN_DAYS=30
MAX_SESSIONS=50
LOCALE=en-IN

# ---- licensing (offline, key-based — no server) ----
# Leave EMPTY to run unrestricted (disabled).
# To enforce, paste ONE key from license-keys.txt below; it validates on boot.
# When it expires, replace it with the next key and restart.
LICENSE_KEY=

# ---- AI reports (optional) ----
# Paste your Anthropic API key to enable "✨ Generate AI report".
# Leave EMPTY to disable AI reports (metrics + chat-data download still work).
ANTHROPIC_API_KEY=

# ---- daily report scheduler ----
# Emails the last-24h report at each time in REPORT_TIMES (24h clock, comma-list),
# interpreted in REPORT_TZ (NOT the server's timezone). Each run covers the last
# 24h relative to that run time. REPORT_SCHEDULE=0 disables.
# Example: REPORT_TIMES=14:00,19:00  -> sends at 2pm and 7pm daily.
REPORT_SCHEDULE=1
REPORT_TIMES=19:00
REPORT_TZ=Asia/Kolkata
# (Legacy single-time fallback if REPORT_TIMES is unset: REPORT_HOUR, REPORT_MINUTE)

# ---- SMTP (email the daily report) ----
# Fill HOST/USER/PASS to enable email. Blank = report is still generated & saved,
# just not emailed. (SMTP_* names also accepted as an alias.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
